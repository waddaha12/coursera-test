import java.util.*;

abstract class Person {
    private String name;
    private int age;

    public Person(String name, int age) {
        this.name = name;
        this.age = age;
    }

    public String getName() { return name; }
    public int getAge() { return age; }

    public abstract void displayInfo();
}

class Doctor extends Person {
    private String specialization;
    private double fee;
    private List<String> appointments = new ArrayList<>();

    public Doctor(String name, int age, String specialization, double fee) {
        super(name, age);
        this.specialization = specialization;
        this.fee = fee;
    }

    public void addAppointment(String info) {
        appointments.add(info);
    }

    public void viewAppointments() {
        System.out.println("\n--- Appointments for Dr. " + getName() + " ---");
        if (appointments.isEmpty()) {
            System.out.println("No appointments.");
        } else {
            for (String a : appointments) System.out.println(a);
        }
    }

    @Override
    public void displayInfo() {
        System.out.println("Doctor: Dr. " + getName() +
            " | Age: " + getAge() +
            " | Specialization: " + specialization +
            " | Fee: $" + fee);
    }
}

class Patient extends Person {
    private String symptoms;
    private List<String> prescriptions = new ArrayList<>();

    public Patient(String name, int age, String symptoms) {
        super(name, age);
        this.symptoms = symptoms;
    }

    public String getSymptoms() { return symptoms; }

    public void addPrescription(String prescription) {
        prescriptions.add(prescription);
    }

    public void viewPrescriptions() {
        System.out.println("\n--- Prescriptions for " + getName() + " ---");
        if (prescriptions.isEmpty()) {
            System.out.println("No prescriptions yet.");
        } else {
            for (String p : prescriptions) System.out.println(p);
        }
    }

    @Override
    public void displayInfo() {
        System.out.println("Patient: " + getName() +
            " | Age: " + getAge() +
            " | Symptoms: " + symptoms);
    }
}

class Appointment {
    private static int counter = 1;
    private int id;
    private Doctor doctor;
    private Patient patient;
    private String date;
    private String status;

    public Appointment(Doctor doctor, Patient patient, String date) {
        this.id = counter++;
        this.doctor = doctor;
        this.patient = patient;
        this.date = date;
        this.status = "Scheduled";
    }

    public int getId() { return id; }
    public Doctor getDoctor() { return doctor; }
    public Patient getPatient() { return patient; }
    public String getStatus() { return status; }

    public void complete() { this.status = "Completed"; }

    public void displayInfo() {
        System.out.println("ID: " + id +
            " | Patient: " + patient.getName() +
            " | Doctor: Dr. " + doctor.getName() +
            " | Date: " + date +
            " | Status: " + status);
    }
}

class ConsultationSystem {
    private List<Doctor> doctors = new ArrayList<>();
    private List<Patient> patients = new ArrayList<>();
    private List<Appointment> appointments = new ArrayList<>();

    public void registerDoctor(Doctor d) {
        doctors.add(d);
        System.out.println("Registered Doctor: Dr. " + d.getName());
    }

    public void registerPatient(Patient p) {
        patients.add(p);
        System.out.println("Registered Patient: " + p.getName());
    }

    public Appointment bookAppointment(Patient patient, Doctor doctor, String date) {
        Appointment a = new Appointment(doctor, patient, date);
        appointments.add(a);
        doctor.addAppointment("Appointment ID: " + a.getId() +
            " with " + patient.getName() + " on " + date);
        System.out.println("Appointment booked! ID: " + a.getId());
        return a;
    }

    public void conductConsultation(Appointment a, String medication, String dosage, String notes) {
        if (a.getStatus().equals("Scheduled")) {
            a.complete();
            String rx = "Appointment ID: " + a.getId() +
                " | Med: " + medication +
                " | Dose: " + dosage +
                " | Notes: " + notes;
            a.getPatient().addPrescription(rx);
            System.out.println("Consultation done. Prescription issued to " + a.getPatient().getName());
        } else {
            System.out.println("Appointment is not scheduled.");
        }
    }

    public void listDoctors() {
        System.out.println("\n=== Available Doctors ===");
        for (Doctor d : doctors) d.displayInfo();
    }

    public void listPatients() {
        System.out.println("\n=== Registered Patients ===");
        for (Patient p : patients) p.displayInfo();
    }

    public void listAppointments() {
        System.out.println("\n=== All Appointments ===");
        for (Appointment a : appointments) a.displayInfo();
    }
}

public class Main {
    public static void main(String[] args) {

        ConsultationSystem system = new ConsultationSystem();

        // Register doctors
        Doctor doc1 = new Doctor("Alice Smith", 45, "Cardiologist", 150.0);
        Doctor doc2 = new Doctor("Bob Jones", 38, "General Physician", 80.0);
        system.registerDoctor(doc1);
        system.registerDoctor(doc2);

        // Register patients
        Patient p1 = new Patient("John Doe", 30, "Chest pain and fatigue");
        Patient p2 = new Patient("Jane Roe", 25, "Fever and headache");
        system.registerPatient(p1);
        system.registerPatient(p2);

        // Display lists
        system.listDoctors();
        system.listPatients();

        // Book appointments
        Appointment a1 = system.bookAppointment(p1, doc1, "2025-03-10 10:00 AM");
        Appointment a2 = system.bookAppointment(p2, doc2, "2025-03-11 02:00 PM");

        // Show appointments
        system.listAppointments();

        // Conduct consultations
        system.conductConsultation(a1, "Aspirin", "100mg daily", "Rest and avoid stress.");
        system.conductConsultation(a2, "Paracetamol", "500mg every 8hrs", "Drink plenty of fluids.");

        // View results
        doc1.viewAppointments();
        doc2.viewAppointments();

        p1.viewPrescriptions();
        p2.viewPrescriptions();

        // Final appointment statuses
        system.listAppointments();
    }
}